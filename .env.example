# Copia este archivo a .env y ajusta los valores en local.
# Aquí no van contraseñas, tokens ni claves.

# Metadatos de MLflow en local. Al usarlo se genera mlflow.db.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Nombres que concentra src/config.py.
MLFLOW_EXPERIMENT_NAME=ejemplo-mlops
MLFLOW_MODEL_NAME=ejemplo-modelo

# Alias del candidato. register.py lo asigna; predict.py carga ese alias.
MLFLOW_MODEL_ALIAS=challenger

# Semilla para partir los datos y entrenar.
RANDOM_SEED=42

# Conjunto pequeño de ejemplo. Los datos grandes no van en este repositorio.
DATA_PATH=data/ejemplo.csv
